<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    
    <persistence-unit name="qrPU" transaction-type="JTA">
        <jta-data-source>jdbc/qrDS</jta-data-source>
        
        <class>com.shakilpatel.qr.entity.QRCode</class>
        <class>com.shakilpatel.qr.entity.QRScan</class>
        <class>com.shakilpatel.qr.entity.QRMessage</class>
        <class>com.shakilpatel.qr.entity.QRAnalyticsDaily</class>
        
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>